# ==========================================================================
# football-quant-engine -- environment template
#
# PLACEHOLDERS ONLY. Never commit real values. The deployed host keeps its own
# .env, which is gitignored and is NOT copied into this repository.
#
# Every name below is read by code in this repo; grep for the name to find the
# reader. Names were enumerated from the source, not invented.
# ==========================================================================

# ---- provider APIs -------------------------------------------------------
# FootyStats REST. Read by the provider client and by the (excluded)
# integration script tests/… real-API probe.
FOOTYSTATS_API_KEY=replace-me

# TheStatsAPI. Both spellings appear in the source; set whichever your
# entry point reads, or both.
THESTATSAPI_API_KEY=replace-me
THESTATS_API_KEY=replace-me

# ---- AWS Bedrock (LLM hypothesis selection) ------------------------------
# Credentials themselves come from the instance role / OIDC / ~/.aws, NOT from
# this file. Only non-secret configuration belongs here.
AWS_REGION=us-east-1
AWS_DEFAULT_REGION=us-east-1
BEDROCK_MODEL_ID=us.anthropic.claude-sonnet-4-6
BEDROCK_TEMPERATURE=0
BEDROCK_MAX_TOKENS=8192
BEDROCK_MAX_INPUT_TOKENS=200000
BEDROCK_MAX_OUTPUT_TOKENS=8192
BEDROCK_MAX_RETRIES=3
BEDROCK_TIMEOUT_SECONDS=120
# Hard spend guard. Keep this set in every non-production environment.
BEDROCK_MAX_AI_CALLS=0
AWS_DAILY_TOKEN_QUOTA=0

# ---- generic LLM client (non-Bedrock paths) ------------------------------
LLM_API_KEY=replace-me

# ---- Telegram notification channels --------------------------------------
# Separate bots per channel so one leak does not expose the others.
TELEGRAM_BOT_TOKEN=replace-me
TELEGRAM_CHAT_ID=replace-me
SIGNALS_TELEGRAM_BOT_TOKEN=replace-me
SIGNALS_TELEGRAM_CHAT_ID=replace-me
RESEARCH_TELEGRAM_BOT_TOKEN=replace-me
RESEARCH_TELEGRAM_CHAT_ID=replace-me
FORECAST_BROADCAST_TELEGRAM_BOT_TOKEN=replace-me
FORECAST_BROADCAST_TELEGRAM_CHAT_ID=replace-me
HEARTBEAT_TELEGRAM_BOT_TOKEN=replace-me
HEARTBEAT_TELEGRAM_CHAT_ID=replace-me

# ---- API service ---------------------------------------------------------
JWT_SECRET_KEY=replace-me

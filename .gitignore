# Survivor Royale - .gitignore

# ===========================
# Python
# ===========================
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.eggs/
*.egg
.venv/
venv/
env/

# ===========================
# Node.js & Dependencies
# ===========================
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
.pnpm-store/

# ===========================
# Environment & Secrets
# ===========================
.env
.env.local
.env.*.local
.env.production
*.key
*.pem
secrets/
.secrets/

# Private keys and wallets
*.keystore
wallet.json
mnemonic.txt

# ===========================
# Build Outputs
# ===========================
dist/
build/
.venv/
.env
.env.local
.pytest_cache/
data/raw/*.json
data/features/*.json
data/results/*.json
data/errors/*.jsonl
!.gitkeep

# Survivor Royale - .gitignore

# ===========================
# Python
# ===========================
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.eggs/
*.egg
.venv/
venv/
env/

# ===========================
# Node.js & Dependencies
# ===========================
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
.pnpm-store/

# ===========================
# Environment & Secrets
# ===========================
.env
.env.local
.env.*.local
.env.production
*.key
*.pem
secrets/
.secrets/

# Private keys and wallets
*.keystore
wallet.json
mnemonic.txt

# ===========================
# Build Outputs
# ===========================
dist/
build/
.venv/
.env
.env.local
.pytest_cache/
data/raw/*.json
data/features/*.json
data/results/*.json
data/errors/*.jsonl
!.gitkeep


# Manual ad-hoc prediction runtime artifacts (data, not code). The ledger/logs are
# generated on real use; the model cache is a regenerable, machine-specific pickle of
# the deterministic fit. Code lives in scripts/manual_predict.py.
data/forward/manual_commitments.jsonl
data/forward/manual_reveals.jsonl
data/forward/manual_predictions.jsonl
data/forward/manual_settled_log.json
data/forward/manual_model_cache_*.pkl
# Heartbeat watchdog dedup state (runtime).
data/discovery/pilotC_heartbeat_state.json

[Unit]
Description=Prospective price-discovery capture (capture-due --hours 96): discover upcoming fixtures across the active FootyStats universe and capture due odds/lineups into the append-only store
Documentation=file:///home/ubuntu/scripts/prospective_capture_run.sh

[Service]
Type=oneshot
WorkingDirectory=/home/ubuntu
TimeoutStartSec=660
ExecStart=/usr/bin/env bash /home/ubuntu/scripts/prospective_capture_run.sh
StandardOutput=journal
StandardError=journal

[Unit]
Description=Weekly research coverage summary (universe + evidence accumulation; no profitability ranking)
Documentation=file:///home/ubuntu/scripts/research_monitor_run.sh

[Timer]
# Monday 09:00 UTC. Deduped per ISO week.
OnCalendar=Mon *-*-* 09:00:00
Persistent=true
AccuracySec=5min
Unit=research-monitor@weekly.service

[Install]
WantedBy=timers.target

{
  "contract_version": "direct_llm_thestatsapi_packet_v1",
  "purpose": "Provider-native, PIT-safe evidence packet for direct LLM hypothesis generation. Research only; no prediction.",
  "provider_policy": {
    "primary_provider": "thestatsapi",
    "cross_provider_match_merge": false,
    "fuzzy_identity_join": false,
    "global_metric_vocabulary_visible_to_llm": false,
    "packet_local_vocabulary_only": true
  },
  "point_in_time": {
    "target_stats_allowed": false,
    "historical_match_must_complete_before_target_kickoff": true,
    "same_or_later_kickoff_allowed": false,
    "market_data_allowed": false,
    "target_outcome_allowed": false,
    "future_lineup_or_injury_data_allowed": false
  },
  "packet_required_keys": [
    "contract_version",
    "fixture",
    "cutoff_unix",
    "provider",
    "packet_metric_vocabulary",
    "evidence_items",
    "provenance"
  ],
  "fixture_required_keys": [
    "fixture_ref",
    "kickoff_unix",
    "competition_ref",
    "team_a_ref",
    "team_b_ref"
  ],
  "evidence_item_required_keys": [
    "evidence_ref",
    "provider",
    "metric",
    "source_fields",
    "team_role",
    "perspective",
    "period",
    "venue_scope",
    "window",
    "value",
    "sample_n",
    "cutoff_unix",
    "semantic_note"
  ],
  "allowed_team_roles": [
    "TEAM_A",
    "TEAM_B",
    "COMPETITION_CONTEXT"
  ],
  "allowed_perspectives": [
    "FOR",
    "AGAINST",
    "NEUTRAL"
  ],
  "allowed_windows": [
    "ALL_PRIOR",
    "RECENT_5"
  ],
  "allowed_venue_scopes": [
    "ALL",
    "HOME",
    "AWAY"
  ],
  "null_policy": "NULL != ZERO. Omit an evidence cell when no valid populated historical observations exist.",
  "vocabulary_rule": "packet_metric_vocabulary MUST equal the sorted unique metric values represented by evidence_items. The LLM may not mention metrics outside this set.",
  "source_metric_examples_from_current_thestatsapi_normalizer": [
    "shots",
    "shots_on_target",
    "shots_inside_box",
    "shots_outside_box",
    "blocked_shots",
    "big_chances",
    "corner_kicks",
    "possession",
    "touches_in_penalty_area",
    "final_third_entries",
    "fouled_in_final_third",
    "accurate_crosses",
    "accurate_long_balls",
    "aerial_duel_pct",
    "ground_duel_pct",
    "tackles",
    "tackles_won_pct",
    "interceptions",
    "clearances",
    "saves",
    "high_claims",
    "goals",
    "yellow_cards",
    "red_cards",
    "fouls"
  ],
  "explicitly_not_automatically_approved": [
    "npxg",
    "goals_prevented",
    "any field with unresolved semantics or inadequate historical coverage"
  ],
  "llm_output_contract": {
    "exact_hypotheses": 5,
    "abstention_allowed": true,
    "required_fields": [
      "hypothesis_id",
      "research_question",
      "mechanism_rationale",
      "evidence_refs",
      "variables_to_measure",
      "conditioning_context",
      "deterministic_measurement_plan",
      "key_confounders",
      "required_resolution",
      "novelty_tags",
      "abstain_reason"
    ],
    "probabilities_forbidden": true,
    "effect_sizes_forbidden": true,
    "odds_forbidden": true,
    "ev_forbidden": true,
    "stakes_forbidden": true,
    "invented_numeric_thresholds_forbidden": true
  },
  "pilot_invariants": {
    "OUT_OF_PACKET_METRIC_RATE": 0,
    "INVALID_EVIDENCE_REF_RATE": 0,
    "LLM_PROBABILITIES_EMITTED": 0,
    "LLM_NUMERIC_EFFECTS_EMITTED": 0
  }
}

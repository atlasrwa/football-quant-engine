  "derivation_rule": {
    "note": "For any exact formation not in exact_to_structure, apply this same digit-band rule at lookup time so the mapping is total; formation_id falls back to 'F_UNK' for such (unlisted) formations even when structurally parseable, keeping the neutral-id namespace closed to formations that have been through explicit review (V3 patch SS10) while the structural counts (which carry no identity) are still safely derivable and returned.",
    "steps": [
      "parse formation into integer bands split on '-'",
      "if unparseable, empty, or any band <= 0 -> FORMATION_STRUCTURE_UNKNOWN (all counts null)",
      "back_line_count = first band; forward_line_count = last band (always literal, unambiguous)",
      "middle = bands[1:-1]",
      "if len(middle) == 1 -> midfield_count = middle[0]; holding/advanced left null",
      "if len(middle) == 2 -> holding_midfield_count = middle[0]; advanced_midfield_count = middle[1]",
      "otherwise (0 or >2 middle bands) -> FORMATION_STRUCTURE_UNKNOWN (all counts null)"
    ]
  }
